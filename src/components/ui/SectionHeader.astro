---
type Props = {
  eyebrow?: string;
  title: string;
  description?: string;
};

const { eyebrow, title, description } = Astro.props;
---

<div class="max-w-3xl space-y-0">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 class="mt-4 max-w-2xl text-balance text-4xl font-black leading-[1.02] tracking-tight text-brand-ink sm:text-5xl lg:text-6xl">{title}</h2>
  {description && <p class="mt-5 max-w-2xl text-base leading-7 text-brand-ink/72 sm:text-lg sm:leading-8">{description}</p>}
</div>
