---
type Props = {
  eyebrow?: string;
  title: string;
  description?: string;
};

const { eyebrow, title, description } = Astro.props;
---

<div class="max-w-2xl">
  {eyebrow && <p class="text-sm font-semibold uppercase tracking-wide text-brand-coral">{eyebrow}</p>}
  <h2 class="mt-2 text-3xl font-semibold tracking-normal text-brand-ink sm:text-4xl">{title}</h2>
  {description && <p class="mt-4 text-base leading-7 text-brand-ink/70">{description}</p>}
</div>
