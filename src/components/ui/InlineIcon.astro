---
type IconName = "tree" | "check" | "phone" | "location" | "fire" | "axe" | "pinned";

type Props = {
  name: IconName;
  class?: string;
};

const { name, class: className = "" } = Astro.props;
---

<span class={`inline-flex h-9 w-9 flex-none items-center justify-center rounded-xl bg-brand-sage/12 text-brand-sage ring-1 ring-brand-sage/20 ${className}`} aria-hidden="true">
  {
    name === "tree" && (
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22V8" />
        <path d="M5 12a7 7 0 0 1 14 0" />
        <path d="M4 12c0 4 3 7 8 7s8-3 8-7" />
        <path d="M8 8c0-3 2-6 4-6s4 3 4 6" />
      </svg>
    )
  }
  {
    name === "check" && (
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 6 9 17l-5-5" />
      </svg>
    )
  }
  {
    name === "phone" && (
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M13.8 16.6a1 1 0 0 0 1.2-.3l.4-.5A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.5.4a1 1 0 0 0-.3 1.2 14 14 0 0 0 6.4 6.4" />
      </svg>
    )
  }
  {
    name === "location" && (
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 10c0 5-5.5 10.2-7.4 11.8a1 1 0 0 1-1.2 0C9.5 20.2 4 15 4 10a8 8 0 0 1 16 0Z" />
        <circle cx="12" cy="10" r="3" />
      </svg>
    )
  }
  {
    name === "fire" && (
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M8.5 14.5A4.5 4.5 0 0 0 13 19a5 5 0 0 0 5-5c0-4-3-6-3-10-2 2-3 4-3 6-1.5-1-2-2.5-2-4-2 2-4 4.5-4 8.5Z" />
      </svg>
    )
  }
  {
    name === "axe" && (
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
        <path d="m14 12 7-7-2-2-7 7" />
        <path d="m5 19 7-7" />
        <path d="m4 20 2 2" />
        <path d="M15 5 19 9" />
      </svg>
    )
  }
  {
    name === "pinned" && (
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
        <path d="m15 4 5 5-4 4v5l-2 2-5-5-5 5 5-5-5-5 2-2h5l4-4Z" />
      </svg>
    )
  }
</span>
