---
type Props = {
  businessName: string;
  tagline: string;
};

const { businessName, tagline } = Astro.props;
---

<section class="home-hero relative isolate overflow-hidden" aria-labelledby="home-hero-title">
  <img
    class="absolute inset-0 -z-20 h-full w-full object-cover object-[64%_center]"
    src="/images/home/home-tree.png"
    alt="Mature tree and landscaped property served by Santos Tree Service"
    width="2048"
    height="1152"
    fetchpriority="high"
  />
  <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(7,28,21,0.92)_0%,rgba(7,28,21,0.72)_38%,rgba(7,28,21,0.2)_75%),linear-gradient(0deg,rgba(7,28,21,0.82)_0%,transparent_48%,rgba(7,28,21,0.18)_100%)]"></div>
  <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(circle_at_18%_20%,rgba(208,160,75,0.26),transparent_27%),radial-gradient(circle_at_82%_14%,rgba(63,116,85,0.22),transparent_34%)]"></div>

  <div class="mx-auto flex min-h-[clamp(29rem,64svh,48rem)] max-w-7xl items-end px-4 pb-16 pt-28 sm:px-6 sm:pb-20 lg:px-8 lg:pb-24">
    <div class="max-w-3xl text-white">
      <p class="eyebrow text-brand-gold">Tree removal · trimming · local care</p>
      <h1 id="home-hero-title" class="mt-5 max-w-3xl text-balance text-5xl font-black leading-[0.94] tracking-tight text-white sm:text-7xl lg:text-8xl">
        Professional tree care for safer properties.
      </h1>
      <p class="mt-7 max-w-2xl text-lg font-medium leading-8 text-white/82 sm:text-xl sm:leading-9">
        {businessName} provides dependable removal, trimming, stump grinding, and firewood service for the Evansville area.
      </p>
      <p class="mt-3 max-w-xl text-sm leading-6 text-white/65 sm:text-base">
        {tagline}
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a class="btn-primary" href="/contact">Get a free estimate</a>
        <a class="inline-flex min-h-11 items-center justify-center rounded-xl border border-white/35 bg-white/10 px-5 py-3 text-sm font-black text-white shadow-[0_14px_34px_rgba(0,0,0,0.16)] backdrop-blur transition-[background-color,border-color,transform] duration-200 hover:-translate-y-0.5 hover:border-brand-gold hover:bg-white/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-gold" href="/services">
          Explore services
        </a>
      </div>
    </div>
  </div>

  <div class="pointer-events-none absolute bottom-5 left-1/2 hidden -translate-x-1/2 items-center gap-3 text-[0.68rem] font-black uppercase tracking-[0.22em] text-white/70 sm:flex" aria-hidden="true">
    <span class="h-px w-10 bg-brand-gold/70"></span>
    Scroll to explore
    <span class="h-px w-10 bg-brand-gold/70"></span>
  </div>
</section>
