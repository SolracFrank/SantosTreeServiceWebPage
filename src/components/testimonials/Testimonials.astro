---
import StarRating from "./StarRating.astro";

const turnstileSiteKey =
  import.meta.env.PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY ||
  import.meta.env.PUBLIC_CLOUDFARE_TURNSTILE_SITE_KEY ||
  import.meta.env.PUBLIC_CLOUDFLARE_TURNSTILE_KEY ||
  import.meta.env.PUBLIC_CLOUDFARE_TURNSTILE_KEY ||
  "";

const hasTurnstileSiteKey = Boolean(turnstileSiteKey);
---

<section
  id="testimonials"
  data-testimonials
  aria-labelledby="testimonials-title"
  class="section-shell py-16 sm:py-20"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <header class="mx-auto mb-10 max-w-3xl text-center">
      <p class="eyebrow">Customer experiences</p>

      <h2
        id="testimonials-title"
        class="mt-4 text-balance text-4xl font-black leading-tight text-brand-ink sm:text-5xl lg:text-6xl"
      >
        What our customers say
      </h2>

      <p
        class="mx-auto mt-5 max-w-2xl text-base leading-7 text-brand-ink/72 sm:text-lg sm:leading-8"
      >
        Read feedback from customers who trusted Santos Tree Service with their
        property and tree care needs.
      </p>
    </header>

    <div class="grid gap-8">
      <!-- Published testimonials -->
      <div class="surface-card-strong p-4 sm:p-5" data-reveal-card>
        <div
          class="flex flex-col gap-3 border-b border-brand-sage/15 px-2 pb-4 sm:flex-row sm:items-end sm:justify-between sm:px-3"
        >
          <div>
            <p class="eyebrow">Published reviews</p>

            <h3 class="mt-2 text-2xl font-black text-brand-ink">
              Real experiences, clearly shared
            </h3>
          </div>

          <p class="text-sm font-semibold text-brand-ink/60">Newest first</p>
        </div>

        <div
          data-testimonials-scroll
          class="mt-4 max-h-[28rem] overflow-y-auto overscroll-contain px-2 pb-2 sm:px-3"
          tabindex="0"
          role="region"
          aria-label="Published customer reviews"
        >
          <div
            data-testimonials-status
            role="status"
            aria-live="polite"
            class="grid gap-4 py-2"
          >
            <span class="sr-only">Loading testimonials窶ｦ</span>

            {
              Array.from({ length: 3 }).map(() => (
                <div
                  aria-hidden="true"
                  class="animate-pulse rounded-2xl border border-brand-ink/10 bg-brand-ink/[0.03] p-5 sm:p-6 motion-reduce:animate-none"
                >
                  <div class="flex items-center gap-2">
                    {Array.from({ length: 5 }).map(() => (
                      <span class="h-4 w-4 rounded-sm bg-brand-ink/12" />
                    ))}
                  </div>

                  <div class="mt-5 h-5 w-2/3 rounded-full bg-brand-ink/12" />
                  <div class="mt-4 h-4 w-full rounded-full bg-brand-ink/10" />
                  <div class="mt-2 h-4 w-11/12 rounded-full bg-brand-ink/10" />

                  <div class="mt-6 border-t border-brand-ink/10 pt-4">
                    <div class="h-4 w-1/3 rounded-full bg-brand-ink/12" />
                    <div class="mt-2 h-3 w-1/4 rounded-full bg-brand-ink/10" />
                  </div>
                </div>
              ))
            }
          </div>

          <div data-testimonials-list class="grid gap-4"></div>
        </div>
      </div>

      <!-- Testimonial form -->
      <div class="surface-card p-6 sm:p-8" data-reveal-card>
        <p class="eyebrow">Share your experience</p>

        <h3 class="mt-3 text-3xl font-black leading-tight text-brand-ink">
          Tell us about your tree care project
        </h3>

        <p class="mt-4 text-base leading-7 text-brand-ink/70">
          Your review helps local customers understand what to expect from
          Santos Tree Service.
        </p>

        <form
          id="testimonial-form"
          class="mt-7 grid gap-5"
          data-testimonial-form
        >
          <div class="grid gap-5 sm:grid-cols-2">
            <!-- Display name -->
            <label
              class="grid gap-2 text-sm font-bold text-brand-ink"
              for="testimonial-display-name"
            >
              <span class="flex min-h-6 items-center gap-1">
                Display name

                <span aria-hidden="true" class="text-brand-coral"> *</span>
              </span>

              <input
                id="testimonial-display-name"
                class="min-h-12 rounded-xl border border-brand-ink/15 bg-white/90 px-4 py-2 text-base transition-[border-color,box-shadow] focus-visible:border-brand-sage focus-visible:ring-4 focus-visible:ring-brand-sage/12"
                type="text"
                name="display_name"
                minlength="2"
                maxlength="80"
                autocomplete="name"
                aria-describedby="testimonial-display-name-help"
                required
              />
            </label>

            <!-- Email -->
            <label
              class="grid gap-2 text-sm font-bold text-brand-ink"
              for="testimonial-email"
            >
              <span class="flex min-h-6 items-center gap-1">
                Email

                <span aria-hidden="true" class="text-brand-coral"> * </span>
              </span>

              <input
                id="testimonial-email"
                class="min-h-12 rounded-xl border border-brand-ink/15 bg-white/90 px-4 py-2 text-base transition-[border-color,box-shadow] focus-visible:border-brand-sage focus-visible:ring-4 focus-visible:ring-brand-sage/12"
                type="email"
                name="email"
                maxlength="100"
                autocomplete="email"
                spellcheck="false"
                required
              />
            </label>
          </div>

          <span id="testimonial-display-name-help" class="sr-only">
            Use between 2 and 80 characters.
          </span>

          <!-- Title -->
          <label
            class="grid gap-2 text-sm font-bold text-brand-ink"
            for="testimonial-title"
          >
            <span class="flex min-h-6 items-center gap-1">
              Review title

              <span aria-hidden="true" class="text-brand-coral"> *</span>
            </span>

            <input
              id="testimonial-title"
              class="min-h-12 rounded-xl border border-brand-ink/15 bg-white/90 px-4 py-2 text-base transition-[border-color,box-shadow] focus-visible:border-brand-sage focus-visible:ring-4 focus-visible:ring-brand-sage/12"
              type="text"
              name="title"
              minlength="3"
              maxlength="120"
              autocomplete="off"
              required
            />
          </label>

          <!-- Content -->
          <label
            class="grid gap-2 text-sm font-bold text-brand-ink"
            for="testimonial-content"
          >
            <span class="flex min-h-6 items-center gap-1">
              Your review

              <span aria-hidden="true" class="text-brand-coral"> * </span>
            </span>

            <textarea
              id="testimonial-content"
              class="min-h-36 resize-y rounded-xl border border-brand-ink/15 bg-white/90 px-4 py-3 text-base leading-7 transition-[border-color,box-shadow] focus-visible:border-brand-sage focus-visible:ring-4 focus-visible:ring-brand-sage/12"
              name="content"
              minlength="10"
              maxlength="500"
              autocomplete="off"
              aria-describedby="testimonial-content-help"
              required></textarea>

            <span
              id="testimonial-content-help"
              class="text-xs font-medium text-brand-ink/55"
            >
              10 to 500 characters
            </span>
          </label>

          <!-- Rating -->
          <StarRating name="rating" label="Rating" />

          <fieldset
            class="rounded-2xl border border-brand-sage/20 bg-brand-sage/[0.06] p-4"
          >
            <legend class="px-1 text-sm font-black text-brand-ink">
              Security check <span aria-hidden="true" class="text-brand-coral">*</span>
            </legend>

            <p class="mt-2 text-sm leading-6 text-brand-ink/65">
              This quick check helps keep automated spam out of customer
              reviews.
            </p>

            {
              hasTurnstileSiteKey ? (
                <div class="mt-4 overflow-hidden rounded-xl bg-white/80 p-2 ring-1 ring-brand-ink/10">
                  <div
                    class="cf-turnstile"
                    data-sitekey={turnstileSiteKey}
                    data-callback="onTurnstileSuccess"
                    data-expired-callback="onTurnstileExpired"
                    data-error-callback="onTurnstileExpired"
                  />

                  <input
                    type="hidden"
                    name="turnstile_token"
                    data-turnstile-token
                  />
                </div>
              ) : (
                <p
                  class="mt-4 rounded-xl border border-brand-coral/25 bg-brand-coral/10 p-3 text-sm font-semibold leading-6 text-brand-ink"
                  role="alert"
                >
                  Review protection is not configured yet. Add the Cloudflare
                  Turnstile site key before accepting testimonials.
                </p>
              )
            }
          </fieldset>

          <!-- Submit -->
          <button
            class="btn-primary mt-1 w-full sm:w-fit"
            type="submit"
            data-testimonial-submit
            disabled={!hasTurnstileSiteKey}
          >
            Submit review
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<dialog
  data-testimonial-dialog
  aria-labelledby="testimonial-dialog-title"
  aria-describedby="testimonial-dialog-message"
  class="m-auto w-[calc(100%-2rem)] max-w-lg rounded-[1.5rem] border border-brand-sage/20 bg-brand-mist p-0 text-brand-ink shadow-[0_28px_90px_rgba(18,37,31,0.28)] backdrop:bg-brand-ink/55"
>
  <div class="relative overflow-hidden p-7 sm:p-8">
    <div
      data-testimonial-dialog-mark
      aria-hidden="true"
      class="mb-5 inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-sage/12 text-xl font-black text-brand-sage ring-1 ring-brand-sage/20"
    >
      ✓
    </div>

    <p data-testimonial-dialog-eyebrow class="eyebrow">Review received</p>

    <h2
      id="testimonial-dialog-title"
      data-testimonial-dialog-title
      class="mt-3 text-3xl font-black leading-tight text-brand-ink"
    >
      Thank you for sharing your experience.
    </h2>

    <p
      id="testimonial-dialog-message"
      data-testimonial-dialog-message
      class="mt-4 text-base leading-7 text-brand-ink/72"
    >
      Your review was sent for moderation and will appear after it is approved.
    </p>

    <button
      type="button"
      data-testimonial-dialog-close
      class="btn-primary mt-7 w-full sm:w-fit"
    >
      Close
    </button>
  </div>
</dialog>

<!-- Testimonial card template -->
<template data-testimonial-template>
  <article
    data-testimonial-card
    class="surface-card-static flex min-h-64 flex-col p-5 sm:p-6"
    data-reveal-card
  >
    <div
      data-testimonial-rating
      class="flex items-center gap-1 text-brand-gold"
    >
    </div>

    <h3
      data-testimonial-title
      class="mt-4 text-xl font-black leading-tight text-brand-ink"
    >
    </h3>

    <p
      data-testimonial-content
      class="mt-3 flex-1 whitespace-pre-wrap break-words text-base leading-7 text-brand-ink/72"
    >
    </p>

    <footer class="mt-5 border-t border-brand-sage/15 pt-4">
      <p data-testimonial-name class="font-black text-brand-ink"></p>

      <time
        data-testimonial-date
        class="mt-1 block text-sm font-medium text-brand-ink/55"
      >
      </time>
    </footer>

    <blockquote
      data-testimonial-response
      hidden
      class="mt-5 rounded-xl border border-brand-gold/20 bg-brand-gold/10 p-4 text-sm leading-6 text-brand-ink/75"
    >
      <p class="font-black text-brand-ink">Company response</p>

      <p
        data-testimonial-response-content
        class="mt-2 whitespace-pre-wrap break-words"
      >
      </p>
    </blockquote>
  </article>
</template>

{
  hasTurnstileSiteKey && (
    <script
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
    />
  )
}

<script>
  import type { Testimonial } from "@/types/testimonials";
  import type { ReviewSubmission } from "@/types/review-submission";

  import { getPublicTestimonials } from "../../lib/testimonials/get-public-testimonials";
  import { submitTestimonial } from "../../lib/testimonials/submit-testimonial";

  declare global {
    interface Window {
      onTurnstileSuccess?: (token: string) => void;
      onTurnstileExpired?: () => void;
      turnstile?: {
        reset: () => void;
      };
    }
  }

  const DATE_FORMATTER = new Intl.DateTimeFormat("en-US", {
    month: "long",
    year: "numeric",
  });

  function formatRating(rating: number): string {
    const normalizedRating = Math.max(1, Math.min(5, Math.round(rating)));

    return "★".repeat(normalizedRating) + "☆".repeat(5 - normalizedRating);
  }

  function formatPublishedDate(publishedAt: string | null): string {
    if (!publishedAt) {
      return "";
    }

    const date = new Date(publishedAt);

    return Number.isNaN(date.getTime()) ? "" : DATE_FORMATTER.format(date);
  }

  function createTestimonialCard(
    testimonial: Testimonial,
    template: HTMLTemplateElement,
  ): DocumentFragment {
    const fragment = template.content.cloneNode(true) as DocumentFragment;

    const cardElement = fragment.querySelector<HTMLElement>(
      "[data-testimonial-card]",
    );

    const ratingElement = fragment.querySelector<HTMLElement>(
      "[data-testimonial-rating]",
    );

    const titleElement = fragment.querySelector<HTMLElement>(
      "[data-testimonial-title]",
    );

    const contentElement = fragment.querySelector<HTMLElement>(
      "[data-testimonial-content]",
    );

    const nameElement = fragment.querySelector<HTMLElement>(
      "[data-testimonial-name]",
    );

    const dateElement = fragment.querySelector<HTMLTimeElement>(
      "[data-testimonial-date]",
    );

    const responseElement = fragment.querySelector<HTMLElement>(
      "[data-testimonial-response]",
    );

    const responseContentElement = fragment.querySelector<HTMLElement>(
      "[data-testimonial-response-content]",
    );

    if (
      !cardElement ||
      !ratingElement ||
      !titleElement ||
      !contentElement ||
      !nameElement ||
      !dateElement ||
      !responseElement ||
      !responseContentElement
    ) {
      throw new Error("The testimonial template is incomplete.");
    }

    cardElement.classList.add("is-visible");

    ratingElement.textContent = formatRating(testimonial.rating);

    ratingElement.setAttribute("role", "img");

    ratingElement.setAttribute(
      "aria-label",
      `${testimonial.rating} out of 5 stars`,
    );

    titleElement.textContent = testimonial.title ?? "Customer review";

    contentElement.textContent = testimonial.content;

    nameElement.textContent = testimonial.display_name ?? "Anonymous";

    const formattedDate = formatPublishedDate(testimonial.published_at);

    if (formattedDate && testimonial.published_at) {
      dateElement.textContent = formattedDate;

      dateElement.dateTime = testimonial.published_at;
    } else {
      dateElement.remove();
    }

    if (testimonial.admin_response) {
      responseContentElement.textContent = testimonial.admin_response;

      responseElement.hidden = false;
    }

    return fragment;
  }

  async function loadTestimonials(section: HTMLElement): Promise<void> {
    const statusElement = section.querySelector<HTMLElement>(
      "[data-testimonials-status]",
    );

    const listElement = section.querySelector<HTMLElement>(
      "[data-testimonials-list]",
    );

    const template = document.querySelector<HTMLTemplateElement>(
      "[data-testimonial-template]",
    );

    if (!statusElement || !listElement || !template) {
      return;
    }

    const setStatusVisibility = (isVisible: boolean) => {
      statusElement.hidden = !isVisible;
      statusElement.classList.toggle("hidden", !isVisible);
    };

    try {
      const testimonials = await getPublicTestimonials(6);

      if (testimonials.length === 0) {
        statusElement.textContent = "No testimonials have been published yet.";
        setStatusVisibility(true);

        return;
      }

      const cardsFragment = document.createDocumentFragment();

      for (const testimonial of testimonials) {
        cardsFragment.append(createTestimonialCard(testimonial, template));
      }

      listElement.replaceChildren(cardsFragment);

      setStatusVisibility(false);
    } catch (error) {
      console.error("Unable to render testimonials:", error);

      statusElement.textContent = "Testimonials are temporarily unavailable.";
      setStatusVisibility(true);
    }
  }

  function getRequiredText(formData: FormData, fieldName: string): string {
    const value = formData.get(fieldName)?.toString().trim();

    return value ?? "";
  }

  const testimonialForm = document.querySelector<HTMLFormElement>(
    "[data-testimonial-form]",
  );

  const testimonialDialog = document.querySelector<HTMLDialogElement>(
    "[data-testimonial-dialog]",
  );

  const testimonialDialogMark = testimonialDialog?.querySelector<HTMLElement>(
    "[data-testimonial-dialog-mark]",
  );

  const testimonialDialogTitle = testimonialDialog?.querySelector<HTMLElement>(
    "[data-testimonial-dialog-title]",
  );

  const testimonialDialogEyebrow =
    testimonialDialog?.querySelector<HTMLElement>(
      "[data-testimonial-dialog-eyebrow]",
    );

  const testimonialDialogMessage =
    testimonialDialog?.querySelector<HTMLElement>(
      "[data-testimonial-dialog-message]",
    );

  const testimonialDialogClose =
    testimonialDialog?.querySelector<HTMLButtonElement>(
      "[data-testimonial-dialog-close]",
    );

  const testimonialSubmitButton =
    testimonialForm?.querySelector<HTMLButtonElement>(
      "[data-testimonial-submit]",
    );

  const turnstileTokenInput =
    testimonialForm?.querySelector<HTMLInputElement>(
      "[data-turnstile-token]",
    );

  window.onTurnstileSuccess = (token: string) => {
    if (turnstileTokenInput) {
      turnstileTokenInput.value = token;
    }
  };

  window.onTurnstileExpired = () => {
    if (turnstileTokenInput) {
      turnstileTokenInput.value = "";
    }
  };

  function showTestimonialDialog(
    state: "success" | "error",
    title: string,
    message: string,
  ): void {
    if (
      !testimonialDialog ||
      !testimonialDialogMark ||
      !testimonialDialogTitle ||
      !testimonialDialogMessage ||
      !testimonialDialogEyebrow
    ) {
      return;
    }

    const isSuccess = state === "success";

    testimonialDialog.dataset.state = state;
    testimonialDialogMark.textContent = isSuccess ? "✓" : "!";
    testimonialDialogMark.classList.toggle("bg-brand-sage/12", isSuccess);
    testimonialDialogMark.classList.toggle("text-brand-sage", isSuccess);
    testimonialDialogMark.classList.toggle("ring-brand-sage/20", isSuccess);
    testimonialDialogMark.classList.toggle("bg-brand-coral/12", !isSuccess);
    testimonialDialogMark.classList.toggle("text-brand-coral", !isSuccess);
    testimonialDialogMark.classList.toggle("ring-brand-coral/20", !isSuccess);
    testimonialDialogEyebrow.textContent = isSuccess
      ? "Review received"
      : "Submission issue";
    testimonialDialogTitle.textContent = title;
    testimonialDialogMessage.textContent = message;

    if (typeof testimonialDialog.showModal === "function") {
      testimonialDialog.showModal();
    } else {
      testimonialDialog.setAttribute("open", "");
    }

    testimonialDialogClose?.focus();
  }

  testimonialDialogClose?.addEventListener("click", () => {
    if (testimonialDialog?.open) {
      testimonialDialog.close();
    }
  });

  testimonialForm?.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (!testimonialSubmitButton) {
      console.error("The testimonial form markup is incomplete.");

      return;
    }

    if (!testimonialForm.reportValidity()) {
      return;
    }

    const formData = new FormData(testimonialForm);

    const turnstileToken =
      getRequiredText(formData, "turnstile_token") ||
      getRequiredText(formData, "cf-turnstile-response");

    if (!turnstileToken) {
      showTestimonialDialog(
        "error",
        "Please complete the security check.",
        "The review could not be sent until Cloudflare Turnstile confirms the form is being submitted by a real visitor.",
      );

      return;
    }

    const submission: ReviewSubmission = {
      email: formData.get("email")?.toString().trim().toLowerCase() ?? "",

      display_name: getRequiredText(formData, "display_name"),

      title: getRequiredText(formData, "title"),

      content: formData.get("content")?.toString().trim() ?? "",

      rating: Number(formData.get("rating")),

      turnstile_token: turnstileToken,
    };

    testimonialSubmitButton.disabled = true;

    testimonialSubmitButton.textContent = "Submitting…";

    let shouldReloadPage = false;

    try {
      const response = await submitTestimonial(submission);

      showTestimonialDialog(
        "success",
        "Thank you for sharing your experience.",
        response.message ||
          "Your review has been verified and published.",
      );

      testimonialSubmitButton.textContent = "Refreshing…";
      shouldReloadPage = true;

      window.setTimeout(() => {
        window.location.reload();
      }, 900);
    } catch (error) {
      console.error("Review submission failed:", error);

      showTestimonialDialog(
        "error",
        "Your review could not be sent.",
        error instanceof Error
          ? error.message
          : "Please try again in a moment.",
      );

      window.turnstile?.reset();
      window.onTurnstileExpired?.();
    } finally {
      if (!shouldReloadPage) {
        testimonialSubmitButton.disabled = false;

        testimonialSubmitButton.textContent = "Submit review";
      }
    }
  });

  const testimonialsSections = document.querySelectorAll<HTMLElement>(
    "[data-testimonials]",
  );

  for (const section of testimonialsSections) {
    void loadTestimonials(section);

    let ticking = false;

    const updateExpandedState = () => {
      section.classList.toggle(
        "is-expanded",
        window.scrollY > window.innerHeight * 0.45,
      );

      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (ticking) {
          return;
        }

        ticking = true;

        window.requestAnimationFrame(updateExpandedState);
      },
      {
        passive: true,
      },
    );

    updateExpandedState();
  }
</script>
