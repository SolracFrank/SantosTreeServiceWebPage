---
const serviceLocations = [
  { name: "Vanderburgh County", state: "IN", lat: 38.0201, lng: -87.5868 },
  { name: "Evansville", state: "IN", lat: 37.9716, lng: -87.5711 },
  { name: "Vincennes", state: "IN", lat: 38.6773, lng: -87.5286 },
  { name: "Boonville", state: "IN", lat: 38.0492, lng: -87.2742 },
  { name: "Rockport", state: "IN", lat: 37.8831, lng: -87.0494 },
  { name: "Darmstadt", state: "IN", lat: 38.1014, lng: -87.5797 },
  { name: "Fort Branch", state: "IN", lat: 38.2512, lng: -87.5811 },
  { name: "Newburgh", state: "IN", lat: 37.9445, lng: -87.4053 },
  { name: "Poseyville", state: "IN", lat: 38.1703, lng: -87.7834 },
  { name: "Elberfeld", state: "IN", lat: 38.1606, lng: -87.4486 },
];
---

<div class="surface-card-strong-static p-2.5 sm:p-4" data-reveal-card>
  <div class="relative overflow-hidden rounded-2xl">
    <div
      class="service-area-map h-[28rem] w-full sm:h-[32rem] lg:h-[36rem]"
      data-service-area-map
      data-locations={JSON.stringify(serviceLocations)}
      aria-label="Interactive map of Santos Tree Service areas served in Indiana"
    >
    </div>

    <div
      class="pointer-events-none absolute left-4 top-4 z-[500] rounded-xl border border-white/70 bg-white/90 px-4 py-3 text-left shadow-[0_18px_60px_rgba(15,23,42,0.14)] backdrop-blur sm:left-6 sm:top-6"
    >
      <p
        class="text-xs font-black uppercase tracking-[0.16em] text-brand-coral"
      >
        Indiana
      </p>

      <p class="mt-1 text-lg font-black text-brand-ink">Service area map</p>
    </div>
  </div>

  <ul class="mt-5 flex h-auto flex-wrap justify-center gap-2">
    {
      serviceLocations.map((location) => (
        <li class="chip">
          {location.name}, {location.state}
        </li>
      ))
    }
  </ul>
</div>

<script is:inline>
  const LEAFLET_CSS_SELECTOR = "[data-leaflet-css]";
  const LEAFLET_SCRIPT_SELECTOR = "[data-leaflet-script]";

  function loadLeafletCss() {
    return new Promise((resolve, reject) => {
      const existingLink = document.querySelector(LEAFLET_CSS_SELECTOR);

      if (existingLink) {
        resolve();
        return;
      }

      const link = document.createElement("link");

      link.rel = "stylesheet";
      link.href = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.css";
      link.integrity = "sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=";
      link.crossOrigin = "anonymous";
      link.dataset.leafletCss = "true";

      link.addEventListener("load", resolve, { once: true });
      link.addEventListener("error", reject, { once: true });

      document.head.appendChild(link);
    });
  }

  function loadLeafletScript() {
    return new Promise((resolve, reject) => {
      if (window.L) {
        resolve(window.L);
        return;
      }

      const existingScript = document.querySelector(LEAFLET_SCRIPT_SELECTOR);

      if (existingScript) {
        existingScript.addEventListener("load", () => resolve(window.L), {
          once: true,
        });

        existingScript.addEventListener("error", reject, {
          once: true,
        });

        return;
      }

      const script = document.createElement("script");

      script.src = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js";

      script.integrity = "sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=";

      script.crossOrigin = "anonymous";
      script.dataset.leafletScript = "true";

      script.addEventListener("load", () => resolve(window.L), { once: true });

      script.addEventListener("error", reject, {
        once: true,
      });

      document.head.appendChild(script);
    });
  }

  function escapeHtml(value) {
    return String(value)
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  async function initServiceAreaMaps() {
    /*
     * Primero CSS y luego JS.
     * Leaflet recomienda expresamente este orden.
     */
    await loadLeafletCss();
    const L = await loadLeafletScript();

    const mapElements = document.querySelectorAll("[data-service-area-map]");

    mapElements.forEach((element) => {
      if (element.dataset.mapReady === "true") {
        return;
      }

      let locations = [];

      try {
        locations = JSON.parse(element.dataset.locations ?? "[]");
      } catch (error) {
        console.error("Invalid service area location data.", error);

        return;
      }

      const map = L.map(element, {
        scrollWheelZoom: true,
        zoomControl: true,
        attributionControl: true,
      });

      L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
        attribution:
          '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
        maxZoom: 19,
      }).addTo(map);

      const icon = L.divIcon({
        className: "service-area-leaflet-pin",
        html: "<span aria-hidden='true'></span>",
        iconAnchor: [14, 28],
        popupAnchor: [0, -28],
        iconSize: [28, 28],
      });

      const bounds = L.latLngBounds([]);

      locations.forEach((location) => {
        const position = [location.lat, location.lng];

        L.marker(position, { icon })
          .addTo(map)
          .bindPopup(
            `<strong>${escapeHtml(location.name)}, ${escapeHtml(location.state)}</strong>`,
          );

        bounds.extend(position);
      });

      element.dataset.mapReady = "true";

      requestAnimationFrame(() => {
        map.invalidateSize();

        if (bounds.isValid()) {
          map.fitBounds(bounds, {
            paddingTopLeft: [50, 110],
            paddingBottomRight: [50, 50],
            maxZoom: 9,
          });
        } else {
          map.setView([38.08, -87.5], 9);
        }
      });

      if ("ResizeObserver" in window) {
        const resizeObserver = new ResizeObserver(() => {
          map.invalidateSize({
            pan: false,
            debounceMoveend: true,
          });
        });

        resizeObserver.observe(element);
      }
    });
  }

  initServiceAreaMaps().catch((error) => {
    console.error("Unable to load the service area map.", error);
  });
</script>
