---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import { getActiveFaqs } from "../lib/supabase/faq";

const faqs = await getActiveFaqs();
---

<BaseLayout title="FAQ | Jime Tienda" description="Preguntas frecuentes de Jime Tienda.">
  <section class="py-16">
    <Container>
      <SectionHeader eyebrow="FAQ" title="Preguntas frecuentes" description="Respuestas base que luego podran administrarse desde Supabase." />
      <div class="mt-10 divide-y divide-black/10 rounded border border-black/10 bg-white">
        {faqs.map((faq) => (
          <article class="p-6">
            <h2 class="text-lg font-semibold text-brand-ink">{faq.question}</h2>
            <p class="mt-3 leading-7 text-brand-ink/70">{faq.answer}</p>
          </article>
        ))}
      </div>
    </Container>
  </section>
</BaseLayout>
