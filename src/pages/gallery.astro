---
import { existsSync, readdirSync } from "node:fs";
import { join, parse } from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import GalleryCarousel, { type GalleryCarouselImage } from "../components/GalleryCarousel.astro";
import PageTitle from "../components/ui/PageTitle.astro";
import SpecSection from "../components/ui/SpecSection.astro";

const galleryDirectory = join(process.cwd(), "public", "images", "gallery");
const imageFiles = existsSync(galleryDirectory)
  ? readdirSync(galleryDirectory)
      .filter((file) => /\.(avif|gif|jpe?g|png|webp)$/i.test(file))
      .sort((first, second) => first.localeCompare(second, undefined, { numeric: true }))
  : [];

const toCaption = (fileName: string) =>
  parse(fileName)
    .name.replace(/[-_]+/g, " ")
    .replace(/\b\w/g, (letter) => letter.toUpperCase());

const images: GalleryCarouselImage[] = imageFiles.map((fileName) => {
  const caption = toCaption(fileName);

  return {
    src: `/images/gallery/${fileName}`,
    alt: `${caption} from Santos Tree Service gallery`,
    caption,
  };
});
---

<BaseLayout
  title="Tree Service Gallery | Santos Tree Service"
  description="View completed tree removal, trimming, cleanup, and outdoor service projects from Santos Tree Service in Evansville, Indiana."
>
  <PageTitle title="Gallery" />

  <SpecSection>
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow">Completed work</p>
      <h2 class="mt-4 text-balance text-3xl font-black leading-tight text-brand-ink sm:text-5xl">Tree service work, completed jobs, trimming, removal, cleanup, and outdoor work.</h2>
      <p class="mt-5 text-lg leading-8 text-brand-ink/70">
        Browse recent outdoor work from Santos Tree Service through a responsive carousel built for mobile, tablet, and desktop.
      </p>
    </div>

    <div class="mt-12">
      {images.length > 0 ? (
        <GalleryCarousel images={images} />
      ) : (
        <div class="surface-card mx-auto max-w-3xl p-8 text-center sm:p-10" data-reveal-card>
          <p class="text-lg font-semibold text-brand-ink">No gallery images were found in public/images/gallery.</p>
        </div>
      )}
    </div>
  </SpecSection>
</BaseLayout>
