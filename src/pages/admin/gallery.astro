---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
---

<BaseLayout
  title="Admin Galeria | Santos Tree Service"
  description="Gestion futura de galeria."
  noindex
>
  <section class="py-20 lg:py-24">
    <Container>
      <SectionHeader
        eyebrow="Admin"
        title="Galeria"
        description="Ruta preparada para futuras operaciones protegidas por autenticacion y RLS."
      />
      <div class="surface-card-static mt-8 p-6 sm:p-8" data-reveal-card>
        <p class="text-brand-ink/70">
          La interfaz de gestion se agregara cuando la autenticacion y permisos
          esten definidos.
        </p>
      </div>
    </Container>
  </section>
</BaseLayout>
