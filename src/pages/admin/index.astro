---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
---

<BaseLayout title="Admin | Jime Tienda" description="Area administrativa futura de Jime Tienda.">
  <section class="py-20 lg:py-24">
    <Container>
      <SectionHeader eyebrow="Admin" title="Panel reservado" description="Esta ruta queda preparada para protegerse con Supabase Auth antes de agregar mutaciones de contenido." />
      <div class="surface-card-strong-static mt-8 p-6 sm:p-8" data-reveal-card>
        <p class="text-brand-ink/70">Proximamente: gestion de galeria, FAQ y contenido del sitio.</p>
      </div>
    </Container>
  </section>
</BaseLayout>
