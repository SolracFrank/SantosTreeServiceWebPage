---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import { getActiveFaqs } from "../lib/supabase/faq";
import { getActiveGalleryImages } from "../lib/supabase/gallery";
import { getSiteSettings } from "../lib/supabase/siteSettings";

const [galleryImages, faqs, settings] = await Promise.all([
  getActiveGalleryImages(),
  getActiveFaqs(),
  getSiteSettings(),
]);

const business = settings.find((item) => item.key === "business")?.value;
const businessName = typeof business?.name === "string" ? business.name : "Jime Tienda";
const tagline = typeof business?.tagline === "string" ? business.tagline : "Informacion clara para clientes y visitantes.";
---

<BaseLayout title={`${businessName} | Inicio`} description={tagline}>
  <section class="bg-white">
    <Container class="grid gap-10 py-16 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:py-20">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-brand-coral">Sitio informativo</p>
        <h1 class="mt-4 text-4xl font-semibold tracking-normal text-brand-ink sm:text-5xl">{businessName}</h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-brand-ink/70">{tagline}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="rounded bg-brand-coral px-5 py-3 text-sm font-semibold text-white transition hover:bg-brand-ink" href="/contact">Contactar</a>
          <a class="rounded border border-brand-ink/20 px-5 py-3 text-sm font-semibold text-brand-ink transition hover:border-brand-coral hover:text-brand-coral" href="/gallery">Ver galeria</a>
        </div>
      </div>
      <img class="aspect-[4/3] w-full rounded object-cover shadow-sm" src={galleryImages[0]?.public_url} alt={galleryImages[0]?.alt_text ?? "Imagen destacada de Jime Tienda"} />
    </Container>
  </section>

  <section class="py-16">
    <Container>
      <SectionHeader eyebrow="Servicios" title="Una base lista para contenido editable" description="La pagina publica queda organizada para mostrar servicios, imagenes, preguntas frecuentes y llamadas a contacto desde datos de Supabase." />
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {["Informacion comercial", "Galeria administrable", "Contacto directo"].map((service) => (
          <article class="rounded border border-black/10 bg-white p-6">
            <h3 class="text-lg font-semibold text-brand-ink">{service}</h3>
            <p class="mt-3 text-sm leading-6 text-brand-ink/70">Contenido placeholder preparado para reemplazarse por datos reales sin cambiar la estructura visual.</p>
          </article>
        ))}
      </div>
    </Container>
  </section>

  <section class="bg-white py-16">
    <Container>
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <SectionHeader eyebrow="Galeria" title="Vista previa" />
        <a class="text-sm font-semibold text-brand-coral hover:text-brand-ink" href="/gallery">Ver todo</a>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {galleryImages.slice(0, 3).map((image) => (
          <article class="overflow-hidden rounded border border-black/10 bg-brand-mist">
            <img class="aspect-[4/3] w-full object-cover" src={image.public_url} alt={image.alt_text ?? image.title ?? "Imagen de galeria"} />
            <div class="p-5">
              <h3 class="font-semibold text-brand-ink">{image.title}</h3>
              {image.description && <p class="mt-2 text-sm leading-6 text-brand-ink/70">{image.description}</p>}
            </div>
          </article>
        ))}
      </div>
    </Container>
  </section>

  <section class="py-16">
    <Container>
      <SectionHeader eyebrow="FAQ" title="Preguntas frecuentes" />
      <div class="mt-8 divide-y divide-black/10 rounded border border-black/10 bg-white">
        {faqs.slice(0, 3).map((faq) => (
          <article class="p-6">
            <h3 class="font-semibold text-brand-ink">{faq.question}</h3>
            <p class="mt-2 text-sm leading-6 text-brand-ink/70">{faq.answer}</p>
          </article>
        ))}
      </div>
    </Container>
  </section>
</BaseLayout>
