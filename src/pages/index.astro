---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeHero from "../components/HomeHero.astro";
import Container from "../components/ui/Container.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import { getActiveFaqs } from "../lib/supabase/faq";
import { getActiveGalleryImages } from "../lib/supabase/gallery";
import { getSiteSettings } from "../lib/supabase/siteSettings";

const [galleryImages, faqs, settings] = await Promise.all([
  getActiveGalleryImages(),
  getActiveFaqs(),
  getSiteSettings(),
]);

const business = settings.find((item) => item.key === "business")?.value;
const businessName =
  typeof business?.name === "string" ? business.name : "Santos Tree Service";
const tagline =
  typeof business?.tagline === "string"
    ? business.tagline
    : "Clear information for customers and visitors.";

const featureCards = [
  {
    title: "Business information",
    icon: "info",
  },
  {
    title: "Manageable gallery",
    icon: "gallery",
  },
  {
    title: "Direct contact",
    icon: "contact",
  },
];
---

<BaseLayout
  title={`${businessName} | Tree Service in Evansville, IN`}
  description="Professional tree removal, trimming, stump grinding, cleanup, and firewood service in Evansville, IN."
>
  <HomeHero slot="home-hero" businessName={businessName} tagline={tagline} />

  <section class="py-24 lg:py-32">
    <Container
      class="grid gap-12 lg:grid-cols-[0.65fr_1.35fr] lg:items-start lg:gap-20"
    >
      <div class="lg:sticky lg:top-32">
        <SectionHeader
          eyebrow="Services"
          title="A foundation ready for editable content"
          description="The public page is organized to display services, images, frequently asked questions, and contact calls-to-action from Supabase data."
        />
      </div>
      <div class="grid gap-5 md:grid-cols-2">
        {
          featureCards.map((feature) => (
            <article class="trust-card group" data-reveal-card>
              <h3 class="flex items-center gap-3 text-lg font-bold text-brand-ink">
                <span class="icon-tile" aria-hidden="true">
                  {feature.icon === "info" && (
                    <svg
                      class="h-5 w-5"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <circle cx="12" cy="12" r="10" />
                      <path d="M12 16v-4M12 8h.01" />
                    </svg>
                  )}
                  {feature.icon === "gallery" && (
                    <svg
                      class="h-5 w-5"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <rect width="18" height="18" x="3" y="3" rx="2" />
                      <path d="M8 8h.01M21 15l-5-5L5 21" />
                    </svg>
                  )}
                  {feature.icon === "contact" && (
                    <svg
                      class="h-5 w-5"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M22 16.92v3a2 2 0 0 1-2.18 2A19.8 19.8 0 0 1 3.09 5.18 2 2 0 0 1 5.08 3h3a2 2 0 0 1 2 1.72c.12.9.33 1.77.62 2.6a2 2 0 0 1-.45 2.11L9 10.68a16 16 0 0 0 4.32 4.32l1.25-1.25a2 2 0 0 1 2.11-.45c.83.29 1.7.5 2.6.62A2 2 0 0 1 22 16.92Z" />
                    </svg>
                  )}
                </span>
                {feature.title}
              </h3>
              <p class="mt-4 text-base leading-7 text-brand-ink/70">
                Placeholder content ready to be replaced with real data without
                changing the visual structure.
              </p>
            </article>
          ))
        }
      </div>
    </Container>
  </section>

  <section class="soft-divider bg-brand-mist/60 py-20 lg:py-24">
    <Container>
      <div
        class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"
      >
        <SectionHeader eyebrow="Gallery" title="Preview" />
        <a class="btn-secondary" href="/gallery">View all</a>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {
          galleryImages.slice(0, 3).map((image) => (
            <article
              class="surface-card group overflow-hidden transition-[transform,box-shadow] duration-300 hover:-translate-y-1 hover:shadow-[0_28px_80px_rgba(15,23,42,0.14)]"
              data-reveal-card="media"
            >
              <img
                class="aspect-[4/3] w-full object-cover"
                src={image.public_url}
                alt={image.alt_text ?? image.title ?? "Gallery image"}
                width="900"
                height="675"
                loading="lazy"
              />
              <div class="p-6">
                <h3 class="font-black text-brand-ink">{image.title}</h3>
                {image.description && (
                  <p class="mt-2 text-sm leading-6 text-brand-ink/70">
                    {image.description}
                  </p>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </Container>
  </section>
</BaseLayout>
