---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageTitle from "../components/ui/PageTitle.astro";
import SpecSection from "../components/ui/SpecSection.astro";
import ServiceAreaMap from "../components/ServiceAreaMap.astro";

const areas = [
  "Vanderburgh County, IN",
  "Evansville, IN",
  "Vincennes, IN",
  "Boonville, IN",
  "Rockport, IN",
  "Darmstadt, IN",
  "Fort Branch, IN",
  "Newburgh, IN",
  "Poseyville, IN",
  "Elberfeld, IN",
];
---

<BaseLayout
  title="About us | Santos Tree Service"
  description="About Santos Tree Service in Evansville, IN."
>
  <PageTitle title="About us" />

  <SpecSection>
    <article
      class="surface-card-strong mx-auto max-w-5xl p-7 text-center sm:p-10 lg:p-12"
      data-reveal-card
    >
      <p class="eyebrow">Local tree care since 2018</p>
      <p class="mx-auto mt-5 max-w-4xl text-lg leading-8 text-brand-ink/80">
        Santos Tree Service is a Better Business Bureau accredited tree service
        company located in Evansville, IN, serving Vanderburgh County and the
        surrounding areas. We specialize in firewood sales, hand tree climbing,
        tree removal, stump grinding, lot clearing, tree trimming, and more.
        Founded in 2018, Santos Tree Service is committed to providing the best
        service to our customers and the highest quality of workmanship. With
        our commitment to safety and customer service, we guarantee that every
        job is done with the utmost professionalism and care. We take pride in
        our work and strive to exceed our customers' expectations. Contact us
        for all of your tree service and firewood needs, today!
      </p>
    </article>
  </SpecSection>

  <SpecSection class="bg-brand-mist/70">
    <div class="grid gap-6 lg:grid-cols-3">
      <div class="surface-card p-8 text-center transition-[transform,box-shadow] duration-300 hover:-translate-y-1 hover:shadow-[0_28px_80px_rgba(15,23,42,0.14)]" data-reveal-card>
        <svg class="mx-auto mb-4 h-8 w-8 text-brand-sage" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8 2v4M16 2v4M3 10h18" />
          <rect width="18" height="18" x="3" y="4" rx="2" />
        </svg>
        <p class="text-5xl font-black text-brand-sage">2018</p>
        <p class="mt-3 font-semibold text-brand-ink/75">Founded</p>
      </div>
      <div class="forest-panel p-8 text-center transition-[transform,box-shadow] duration-300 hover:-translate-y-1 hover:shadow-[0_28px_80px_rgba(15,23,42,0.22)]" data-reveal-card>
        <div class="mb-4 flex items-center justify-center gap-3">
          <svg class="h-8 w-8 text-brand-sage" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2 15 8l6 .9-4.5 4.4 1.1 6.2L12 16.4 6.4 19.5l1.1-6.2L3 8.9 9 8l3-6Z" />
          </svg>
          <p class="text-5xl font-black text-brand-sage">BBB</p>
        </div>
        <p class="mt-3 font-semibold text-white/75">Accredited</p>
      </div>
      <div class="surface-card p-8 text-center transition-[transform,box-shadow] duration-300 hover:-translate-y-1 hover:shadow-[0_28px_80px_rgba(15,23,42,0.14)]" data-reveal-card>
        <svg class="mx-auto mb-4 h-8 w-8 text-brand-sage" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0Z" />
          <circle cx="12" cy="10" r="3" />
        </svg>
        <p class="text-5xl font-black text-brand-sage">IN</p>
        <p class="mt-3 font-semibold text-brand-ink/75">Evansville</p>
      </div>
    </div>
  </SpecSection>

  <SpecSection>
    <div class="mx-auto max-w-5xl text-center">
      <h2 class="text-3xl font-black text-brand-ink sm:text-5xl">
        Areas Served:
      </h2>
      <ul class="mt-8 flex flex-wrap justify-center gap-3">
        {areas.map((area) => <li class="chip">{area}</li>)}
      </ul>
    </div>
  </SpecSection>

  <SpecSection class="bg-brand-mist/70">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto mb-10 max-w-3xl text-center">
        <p class="eyebrow">Service coverage</p>
        <h2 class="mt-4 text-balance text-3xl font-black leading-tight text-brand-ink sm:text-5xl">
          Areas served across southwest Indiana
        </h2>
        <p class="mt-5 text-lg leading-8 text-brand-ink/70">
          Explore the communities Santos Tree Service serves for tree removal,
          trimming, stump grinding, cleanup, and firewood.
        </p>
      </div>
      <ServiceAreaMap />
    </div>
  </SpecSection>
</BaseLayout>
