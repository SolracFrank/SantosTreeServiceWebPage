---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";

type Props = {
  title?: string;
  description?: string;
  noindex?: boolean;
  image?: string;
  imageAlt?: string;
};

const {
  title = "Santos Tree Service",
  description = "Tree service company located in Evansville, IN, serving Vanderburgh County and the surrounding areas.",
  noindex = false,
  image = "/images/logo_trans_golden.png",
  imageAlt = "Santos Tree Service logo",
} = Astro.props;

const isHomePage = Astro.url.pathname === "/";
const isFaqPage =
  Astro.url.pathname.endsWith("/faq") || Astro.url.pathname.endsWith("/faq/");
const siteUrl = import.meta.env.PUBLIC_SITE_URL?.trim().replace(/\/+$/, "");
const canonicalPath =
  Astro.url.pathname === "/"
    ? "/"
    : `${Astro.url.pathname.replace(/\/+$/, "")}/`;
const toAbsoluteUrl = (path: string) =>
  siteUrl ? new URL(path, `${siteUrl}/`).toString() : path;
const canonicalUrl = toAbsoluteUrl(canonicalPath);
const imageUrl = toAbsoluteUrl(image);
const robots = noindex ? "noindex, nofollow" : "index, follow";

---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="UTF-8" />

    <meta name="description" content={description} />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="generator" content={Astro.generator} />

    <meta name="robots" content={robots} />

    <meta name="theme-color" content="#12251f" />

    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />

    <meta property="og:site_name" content="Santos Tree Service" />

    <meta property="og:title" content={title} />

    <meta property="og:description" content={description} />

    <meta property="og:url" content={canonicalUrl} />

    <meta property="og:image" content={imageUrl} />

    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />

    <meta name="twitter:title" content={title} />

    <meta name="twitter:description" content={description} />

    <meta name="twitter:image" content={imageUrl} />

    <!-- Modern browsers -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />

    <!-- PNG fallbacks -->
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon-32x32.png?v=2"
    />

    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicon-16x16.png?v=2"
    />

    <!-- Legacy browsers / crawlers -->
    <link rel="shortcut icon" href="/favicon.ico?v=2" />

    <!-- iPhone / iPad -->
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/favicon-180x180.png?v=2"
    />

    <title>{title}</title>

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "Santos Tree Service",
        "description": "Professional tree removal, trimming, stump grinding, cleanup, and firewood service in Evansville, Indiana.",
        "telephone": "+18126026388",
        "email": "Eestrada@santostreeservicesevv.com",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "12425 N Green River Rd",
          "addressLocality": "Evansville",
          "addressRegion": "IN",
          "postalCode": "47725",
          "addressCountry": "US"
        },
        "areaServed": [
          "Evansville",
          "Vanderburgh County",
          "Newburgh",
          "Boonville",
          "Darmstadt",
          "Fort Branch",
          "Poseyville",
          "Elberfeld",
          "Rockport",
          "Vincennes"
        ],
        "sameAs": ["https://www.facebook.com/share/1828QSZsce/?mibextid=wwXIfr"]
      }
    </script>

    <script is:inline>
      document.documentElement.classList.remove("no-js");
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body class="min-h-screen bg-transparent text-brand-ink antialiased">
    <a class="skip-link" href="#main-content">Skip to content</a>
    {
      isHomePage && (
        <div class="home-presentation">
          <slot name="home-hero" />
        </div>
      )
    }
    <Header />
    <main id="main-content" class={isFaqPage ? "page-faq" : undefined}>
      <slot />
    </main>
    <Footer />
    <script is:inline>
      document.documentElement.classList.add("reveal-ready");

      const revealTargets = document.querySelectorAll(
        "main:not(.page-faq) [data-reveal-card]",
      );

      const revealTarget = (target, index) => {
        target.style.setProperty(
          "--reveal-delay",
          `${Math.min(index % 5, 4) * 70}ms`,
        );
        target.classList.add("is-visible");
      };

      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              const index = Array.prototype.indexOf.call(
                revealTargets,
                entry.target,
              );
              revealTarget(entry.target, index < 0 ? 0 : index);
              observer.unobserve(entry.target);
            });
          },
          {
            rootMargin: "0px 0px -8% 0px",
            threshold: 0.08,
          },
        );

        revealTargets.forEach((target) => observer.observe(target));
      } else {
        revealTargets.forEach(revealTarget);
      }
    </script>
  </body>
</html>
