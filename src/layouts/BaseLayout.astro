---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "Jime Tienda Informativa",
  description = "Sitio informativo con servicios, galeria, preguntas frecuentes y contacto.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-brand-mist text-brand-ink antialiased">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
