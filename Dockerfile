FROM node:22-alpine AS build

ENV PNPM_HOME="/pnpm"
ENV PATH="${PNPM_HOME}:${PATH}"

ARG PUBLIC_SUPABASE_URL
ARG PUBLIC_SUPABASE_ANON_KEY
ARG PUBLIC_SUPABASE_PUBLISHABLE_KEY
ARG PUBLIC_SITE_URL
ARG PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY
ARG PUBLIC_CLOUDFARE_TURNSTILE_SITE_KEY
ARG PUBLIC_CLOUDFLARE_TURNSTILE_KEY
ARG PUBLIC_CLOUDFARE_TURNSTILE_KEY

ENV PUBLIC_SUPABASE_URL="${PUBLIC_SUPABASE_URL}"
ENV PUBLIC_SUPABASE_ANON_KEY="${PUBLIC_SUPABASE_ANON_KEY}"
ENV PUBLIC_SUPABASE_PUBLISHABLE_KEY="${PUBLIC_SUPABASE_PUBLISHABLE_KEY}"
ENV PUBLIC_SITE_URL="${PUBLIC_SITE_URL}"
ENV PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY="${PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY}"
ENV PUBLIC_CLOUDFARE_TURNSTILE_SITE_KEY="${PUBLIC_CLOUDFARE_TURNSTILE_SITE_KEY}"
ENV PUBLIC_CLOUDFLARE_TURNSTILE_KEY="${PUBLIC_CLOUDFLARE_TURNSTILE_KEY}"
ENV PUBLIC_CLOUDFARE_TURNSTILE_KEY="${PUBLIC_CLOUDFARE_TURNSTILE_KEY}"

WORKDIR /app

RUN corepack enable \
    && corepack install --global pnpm@10.34.5 \
    && pnpm config set store-dir /pnpm/store --global

COPY package.json pnpm-lock.yaml ./

RUN pnpm install --frozen-lockfile

COPY . .

RUN pnpm build

FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
